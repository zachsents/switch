<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (SPEC.md §11.7). Development signing pushes through APNs' sandbox; the app tells the core which it is. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Urgent action items break through Focus. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- The pairing's credential, shared with the share extension (Credential.swift): first, so it's where items go. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID).shared</string>
	</array>
</dict>
</plist>
