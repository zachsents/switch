{
  "name": "switch-ext-amazon",
  "version": "0.1.0",
  "private": true,
  "description": "Amazon reorders and cart checkouts in the user's own browser.",
  "license": "UNLICENSED",
  "scripts": {
    "check": "uvx ruff check --no-cache --select E9,F63,F7,F82 --exclude home . && python3 check.py"
  },
  "extension": {
    "name": "amazon",
    "command": [
      "python3",
      "./main.py"
    ],
    "shim": "switchboard",
    "needs": [
      "macos"
    ],
    "heartbeat": 1800000,
    "connections": [
      {
        "provider": "amazon",
        "kind": "session",
        "label": "Amazon",
        "scopes": [],
        "multiple": false
      }
    ]
  }
}
