{
  "name": "switch-ext-macos",
  "version": "0.1.0",
  "private": true,
  "description": "A Mac as the agent's body, as a Switch extension.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zachsents/switch",
    "directory": "extensions/macos"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt --write .",
    "fix": "bun run lint && bun run format",
    "check": "bun run typecheck && bun run fix"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "effect": "^4.1.5",
    "switch-ext-kit": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "ultracite": "^8.3.1"
  },
  "extension": {
    "name": "macos",
    "main": "src/main.ts",
    "heartbeat": 420000,
    "needs": [
      "macos"
    ],
    "every": true,
    "widgets": [
      "vitals",
      "screen"
    ]
  }
}
