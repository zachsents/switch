{
  "name": "switch-ext-ghostty",
  "version": "0.1.0",
  "private": true,
  "description": "Ghostty, the terminal, as a Switch extension: a window, tab or split with a command typed, typing into a terminal, its windows listed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zachsents/switch",
    "directory": "extensions/ghostty"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt --write .",
    "fix": "bun run lint && bun run format",
    "check": "bun run typecheck && bun run captions && bun run fix",
    "captions": "ui-captions src"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "effect": "^4.1.5",
    "switch-ext-kit": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "ultracite": "^8.3.1"
  },
  "extension": {
    "name": "ghostty",
    "main": "src/main.ts",
    "heartbeat": 360000,
    "needs": [
      "macos"
    ],
    "every": true
  }
}
