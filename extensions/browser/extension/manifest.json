{
  "manifest_version": 3,
  "name": "Switch",
  "version": "1.1",
  "key": "",
  "description": "Lets Switch, the agent on your Mac, see the page you're on and work for you in background tabs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging", "tabs", "debugger", "tabGroups", "storage", "alarms", "idle"],
  "background": { "service_worker": "background.js" }
}
