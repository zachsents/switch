{
  "name": "switch-ext-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Reads documents (pages, PDF, EPUB, web articles, Markdown, DOCX and more) with definitions, Wikipedia and isolated follow-up threads, as a Switch extension.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zachsents/switch",
    "directory": "extensions/reader"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware --fix --fix-suggestions",
    "format": "oxfmt --write .",
    "fix": "bun run lint && bun run format",
    "check": "bun run typecheck && bun run captions && bun run fix",
    "captions": "ui-captions src"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@mozilla/readability": "^0.6.0",
    "effect": "^4.1.5",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.15",
    "mammoth": "^1.13.0",
    "switch-ext-kit": "^0.2.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^2.2.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/turndown": "^5.0.6",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "ultracite": "^8.3.1"
  },
  "extension": {
    "name": "reader",
    "main": "src/main.ts",
    "heartbeat": 300000,
    "widgets": [
      "document",
      "documents"
    ]
  }
}
